# Defense-in-depth: Vercel CLI already respects .gitignore, but make it
# explicit so no secret-bearing file ever gets uploaded in a build artifact.
.env
.env.*
!.env.example
db/cloudkv.json
db/custom.db
db/*.json
db/*.db
dev.log
dev.out.log
.next/
.next-dev.pid
tool-results/
download/
upload/
skills/
worklog.md
agent-ctx/
plan.md
*.log
*.png.bak
.claude
.z-ai-config
.zscripts/
